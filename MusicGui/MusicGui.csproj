<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Аддон: переписанная WinForms-программа, теперь — DLL-плагин для ядра -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MusicGui</AssemblyName>
    <RootNamespace>MusicGui</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ядро — референс только на время компиляции; в рантайме типы берутся из сборки ядра -->
    <ProjectReference Include="..\Core\Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
